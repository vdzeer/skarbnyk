rules_version = '2';

// Security rules for the Скарбник Firestore database.
//
// One invariant: user data is owner-scoped. Every document carries an
// `owner_uid`, and a caller may only touch the ones where that field equals
// their own auth uid. `owner_uid` is written once, at create, and can never be
// moved afterwards. `keys`, `profiles` and `reminders` hold one document per
// user, so there the document id must be the uid as well.
//
// The server never sees the numbers. `profiles`, `incomes` and `marks` keep
// only `owner_uid`, `v`, `iv` and `ct` in the open: `ct` is AES-GCM made in
// the browser with a data key the server does not hold. These rules can check
// the envelope (its keys and sizes), not what is sealed inside it; the AAD the
// app binds to collection, document id and uid is what stops a ciphertext
// being copied into another document.
//
// `keys` is that data key wrapped twice, by a password-derived key and by a
// recovery key. Every field is base64 of a fixed number of bytes, so the sizes
// are exact: a 16-byte salt is 24 characters, a 12-byte IV is 16, and a
// wrapped 32-byte key with its 16-byte GCM tag is 64.
//
// `reminders` is the one plaintext collection, switched on by the user so a
// scheduled function can email deadlines. Its `email` must be the verified
// address on the caller's own token, so nobody can make the app write to a
// stranger.
//
// `incomes` and `marks` are read as list queries. Firestore only allows a
// list when the query itself guarantees the rule, so the app filters on
// `where('owner_uid', '==', uid)`; dropping that clause makes the query fail
// here rather than return someone else's rows.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ---------------------------------------------------------

    // Google is the only sign-in the app offers. Checking the provider keeps
    // anonymous and email/password accounts out even if one of those methods
    // is ever switched on in the console: the public web config must not be
    // enough to mint throwaway users that write here.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // The caller is the user the document id names. The one-per-user
    // collections check the path rather than the stored document, which is
    // what lets the app read its own document before it exists (first
    // sign-in asks whether `keys/{uid}` is there yet).
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The document being written declares the caller as its owner.
    function incomingIsOwn() {
      return signedIn()
        && request.resource.data.owner_uid is string
        && request.resource.data.owner_uid == request.auth.uid;
    }

    // The document already stored belongs to the caller.
    function storedIsOwn() {
      return signedIn()
        && resource.data.owner_uid == request.auth.uid;
    }

    // `owner_uid` is set at create and is immutable from then on.
    function ownerUnchanged() {
      return request.resource.data.owner_uid == resource.data.owner_uid;
    }

    // Only one document format exists so far. A `v: 2` is a client that is
    // ahead of these rules, and it waits until they learn the new format.
    function versionValid() {
      return request.resource.data.v is int
        && request.resource.data.v == 1;
    }

    function sizedString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // ---- sealed documents: profiles, incomes, marks ------------------------

    // The envelope every encrypted document shares. `maxCt` is the longest
    // ciphertext the collection's model can produce, with room to spare.
    function sealedShapeValid(maxCt) {
      return request.resource.data.keys().hasAll(['owner_uid', 'v', 'iv', 'ct'])
        && request.resource.data.keys().hasOnly(['owner_uid', 'v', 'iv', 'ct'])
        && versionValid()
        && sizedString(request.resource.data.iv, 16, 16)
        && sizedString(request.resource.data.ct, 1, maxCt);
    }

    // ---- keys ------------------------------------------------------------

    // A password change or a new recovery key rewraps the same data key, so
    // an update is a whole new shape over the old one; the documents it
    // unlocks are not touched.
    function keyShapeValid() {
      return request.resource.data.keys().hasAll(
          ['owner_uid', 'v', 'kdf_iterations', 'kdf_salt', 'password_iv',
           'password_key', 'recovery_salt', 'recovery_iv', 'recovery_key'])
        && request.resource.data.keys().hasOnly(
          ['owner_uid', 'v', 'kdf_iterations', 'kdf_salt', 'password_iv',
           'password_key', 'recovery_salt', 'recovery_iv', 'recovery_key'])
        && versionValid()
        && request.resource.data.kdf_iterations is int
        && request.resource.data.kdf_iterations >= 100000
        && request.resource.data.kdf_iterations <= 10000000
        && sizedString(request.resource.data.kdf_salt, 24, 24)
        && sizedString(request.resource.data.password_iv, 16, 16)
        && sizedString(request.resource.data.password_key, 64, 64)
        && sizedString(request.resource.data.recovery_salt, 24, 24)
        && sizedString(request.resource.data.recovery_iv, 16, 16)
        && sizedString(request.resource.data.recovery_key, 64, 64);
    }

    match /keys/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && incomingIsOwn() && keyShapeValid();
      allow update: if isSelf(uid)
        && incomingIsOwn()
        && ownerUnchanged()
        && keyShapeValid();
      allow delete: if isSelf(uid);
    }

    // ---- profiles --------------------------------------------------------

    // Settings: group and its periods, VAT, registration date, ЄСВ, rates by
    // year, requisites. Larger than a single entry, hence the larger bound.
    match /profiles/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && incomingIsOwn()
        && sealedShapeValid(40000);
      allow update: if isSelf(uid)
        && incomingIsOwn()
        && ownerUnchanged()
        && sealedShapeValid(40000);
      allow delete: if isSelf(uid);
    }

    // ---- incomes ---------------------------------------------------------

    // One receipt: date, amount, currency, rate, amount in hryvnias, note.
    match /incomes/{incomeId} {
      allow read: if storedIsOwn();
      allow create: if incomingIsOwn() && sealedShapeValid(4000);
      allow update: if storedIsOwn()
        && incomingIsOwn()
        && ownerUnchanged()
        && sealedShapeValid(4000);
      allow delete: if storedIsOwn();
    }

    // ---- marks -----------------------------------------------------------

    // One "paid" or "filed" mark: which obligation, date, amount.
    match /marks/{markId} {
      allow read: if storedIsOwn();
      allow create: if incomingIsOwn() && sealedShapeValid(2000);
      allow update: if storedIsOwn()
        && incomingIsOwn()
        && ownerUnchanged()
        && sealedShapeValid(2000);
      allow delete: if storedIsOwn();
    }

    // ---- reminders -------------------------------------------------------

    // Deliberately plaintext and opt-in: the scheduled function reads the
    // address, the tax group and how many days ahead to write, and nothing
    // else. The email is checked on every write, including switching the
    // reminders off, and `updated_at` must be `serverTimestamp()`, which rules
    // see as `request.time`, so every update has to set it again.
    function reminderShapeValid() {
      return request.resource.data.keys().hasAll(
          ['owner_uid', 'email', 'enabled', 'group', 'offsets', 'updated_at'])
        && request.resource.data.keys().hasOnly(
          ['owner_uid', 'email', 'enabled', 'group', 'offsets', 'updated_at'])
        && request.auth.token.email_verified == true
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.enabled is bool
        && request.resource.data.group is int
        && request.resource.data.group in [1, 2, 3]
        && request.resource.data.offsets is list
        && request.resource.data.offsets.size() >= 1
        && request.resource.data.offsets.size() <= 3
        && request.resource.data.offsets.hasOnly([0, 1, 3, 7, 14])
        && request.resource.data.updated_at == request.time;
    }

    match /reminders/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && incomingIsOwn()
        && reminderShapeValid();
      allow update: if isSelf(uid)
        && incomingIsOwn()
        && ownerUnchanged()
        && reminderShapeValid();
      allow delete: if isSelf(uid);
    }

    // ---- everything else -------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
