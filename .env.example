# Firebase web app config (Project settings → Your apps → Web app).
# These values are public identifiers, not secrets, but they still live in
# env files so dev and release can point at different projects.
#
# Copy this file twice:
# - `.env` for local development against the emulators: project id
#   `demo-skarbnyk`, any non-empty API key and app id, and
#   NEXT_PUBLIC_USE_EMULATORS=1 (see README.md);
# - `.env.production` for `npm run build`: the values of your own Firebase
#   web app (`firebase apps:sdkconfig WEB`).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 1 = talk to the local Auth and Firestore emulators (npm run emulators).
# Must be 0 in .env.production.
NEXT_PUBLIC_USE_EMULATORS=0

# 1 once the reminder mailer (functions/) is deployed; until then the
# reminders card says it is not ready instead of promising letters.
NEXT_PUBLIC_EMAIL_REMINDERS=0

# Optional App Check: the score-based reCAPTCHA Enterprise site key of the web
# app (README.md, "Optional: App Check"). Empty = App Check off. Ignored while
# NEXT_PUBLIC_USE_EMULATORS=1. The build adds the reCAPTCHA hosts to the
# Content-Security-Policy when it is set.
NEXT_PUBLIC_APPCHECK_SITE_KEY=
